<div class="text-editor">
    <pre class="text-editor-gutter" aria-hidden="true">@_numbers</pre>
    <textarea class="text-editor-input" wrap="off" spellcheck="false" rows="@_lineCount" cols="@_columns"
              aria-label="@Label" @key="_field.Generation" value="@_field.Rendered" @oninput="OnInput"></textarea>
</div>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    // The text area is given a value only when the text changes from outside, never for what was typed (see FieldValue).
    private FieldValue _field = default!;

    // Worked out once per change of the text, not once per render: the text can be as long as a megabyte.
    private string? _measuredText;
    private int _lineCount = 1;
    private int _columns = 1;
    private string _numbers = "1";

    protected override void OnParametersSet()
    {
        if (_field is null)
        {
            _field = new FieldValue(Text);
        }
        else
        {
            _field.Offered(Text);
        }

        if (_measuredText is not null && string.Equals(_measuredText, Text, StringComparison.Ordinal))
        {
            return;
        }

        var lines = Text.Split('\n');
        _measuredText = Text;
        _lineCount = lines.Length;

        // The text area is as big as its text and the container scrolls it, so the gutter always stays beside the lines.
        _columns = lines.Max(line => line.Length) + 1;
        _numbers = string.Join('\n', Enumerable.Range(1, lines.Length));
    }

    private Task OnInput(ChangeEventArgs args)
    {
        var text = (string?)args.Value ?? "";
        _field.Typed(text);

        return TextChanged.InvokeAsync(text);
    }
}
