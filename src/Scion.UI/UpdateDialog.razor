@inherits UpdateSessionComponent
@inject IExternalLinks Links
@inject UpdateLinks UpdateLinks

@* The backdrop takes the keys, so Esc still works after a click on it moved the focus there. A click on it closes nothing. *@
@if (Session.IsDialogOpen && Session.Update is { } update)
{
    <div class="dialog-backdrop" tabindex="-1" @onkeydown="OnKeyDown">
        <div class="dialog dialog-update" role="dialog" aria-modal="true" aria-labelledby="update-dialog-title" tabindex="-1" @ref="_dialog">
            <header class="dialog-header">
                <div class="dialog-heading">
                    <h2 id="update-dialog-title">@Title(update)</h2>
                    @if (Subtitle is { } subtitle)
                    {
                        <p class="dialog-subtitle">@subtitle</p>
                    }
                </div>
                <button type="button" class="icon-button dialog-close" aria-label="Close" @onclick="Dismiss"><CloseIcon /></button>
            </header>

            @switch (Session.Stage)
            {
                case UpdateStage.Available:
                    <section class="update-whats-new" aria-label="@UpdateMessages.WhatsNew">
                        <h3 class="update-notes-title">@UpdateMessages.WhatsNew</h3>
                        <div class="update-notes">
                            @if (update.ReleaseNotes is { } notes)
                            {
                                <MarkdownView Text="@notes" />
                            }
                            else
                            {
                                <p class="update-notes-empty">@UpdateMessages.NoReleaseNotes</p>
                            }
                        </div>
                    </section>
                    <footer class="dialog-footer dialog-footer-end">
                        <button type="button" class="button button-secondary" @onclick="Session.Later">@UpdateMessages.Later</button>
                        <button type="button" class="button button-primary" @onclick="Session.DownloadAsync">@UpdateMessages.DownloadUpdate</button>
                    </footer>
                    break;

                case UpdateStage.Downloading:
                    <div class="update-progress">
                        <div class="progress progress-determinate" role="progressbar" aria-label="Downloading"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Session.Percent">
                            <div class="progress-fill" style="width: @(Session.Percent)%"></div>
                        </div>
                        <span class="update-percent">@UpdateMessages.Percent(Session.Percent)</span>
                    </div>
                    <footer class="dialog-footer dialog-footer-end">
                        <button type="button" class="button button-secondary" @onclick="Session.CancelDownload">@UpdateMessages.Cancel</button>
                    </footer>
                    break;

                case UpdateStage.Ready:
                    <footer class="dialog-footer dialog-footer-end">
                        <button type="button" class="button button-secondary" @onclick="Session.Later">@UpdateMessages.Later</button>
                        <button type="button" class="button button-primary" @onclick="Session.RestartAsync">@UpdateMessages.RestartNow</button>
                    </footer>
                    break;

                case UpdateStage.Failed:
                    <div class="update-failure">
                        <p class="field-problem" role="alert"><WarningIcon />@UpdateMessages.For(Session.Failure!.Value)</p>
                        <button type="button" class="text-action update-link" @onclick="OpenReleasesPageAsync">@UpdateMessages.DownloadFromGitHub</button>
                    </div>
                    <footer class="dialog-footer dialog-footer-end">
                        <button type="button" class="button button-secondary" @onclick="Session.Later">@UpdateMessages.Close</button>
                        <button type="button" class="button button-secondary" @onclick="Session.TryAgainAsync">@UpdateMessages.TryAgain</button>
                    </footer>
                    break;
            }
        </div>
    </div>
}

@code {
    private ElementReference _dialog;
    private UpdateStage? _focusedFor;

    private string Title(AvailableUpdate update) => Session.Stage switch
    {
        UpdateStage.Downloading => UpdateMessages.Downloading(update.Version),
        UpdateStage.Ready => UpdateMessages.Ready(update.Version),
        UpdateStage.Failed => UpdateMessages.FailedTitle,
        _ => UpdateMessages.Available(update.Version),
    };

    private string? Subtitle => Session.Stage switch
    {
        UpdateStage.Available => UpdateMessages.YouHave(Session.CurrentVersion),
        UpdateStage.Ready => UpdateMessages.RestartToFinish,
        _ => null,
    };

    // Each step has other buttons, so the focus goes back to the dialog when the step changes: Esc must keep working.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        UpdateStage? shown = Session.IsDialogOpen && Session.Update is not null ? Session.Stage : null;

        if (shown is not null && shown != _focusedFor)
        {
            await _dialog.FocusAsync();
        }

        _focusedFor = shown;
    }

    /// <summary>The × and Esc choose the safe way out: Later, or Cancel while a download runs.</summary>
    private void Dismiss()
    {
        if (Session.Stage == UpdateStage.Downloading)
        {
            Session.CancelDownload();
        }
        else
        {
            Session.Later();
        }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Dismiss();
        }
    }

    private Task OpenReleasesPageAsync() => Links.OpenAsync(UpdateLinks.ReleasesPage);
}
