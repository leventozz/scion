<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- No dot in the folder name: codesign takes "_content/Scion.UI" for a bundle (see MacSigningTests). -->
    <StaticWebAssetBasePath>_content/ScionUI</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scion.Application\Scion.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scion.UI.Tests" />
  </ItemGroup>

</Project>
