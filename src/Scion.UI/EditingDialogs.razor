@* Everything around an editing session that is not the editor itself: the Ctrl+S shortcut and the two questions. *@
<SaveShortcut Active="IsEditing" OnSave="OnSaveShortcut" />

@if (IsConfirmingDiscard)
{
    <DiscardChangesDialog FileName="@FileName" OnKeepEditing="OnKeepEditing" OnDiscard="OnDiscard" />
}

@if (Conflict is { } conflict)
{
    <ChangedOnDiskDialog FileName="@FileName" Conflict="conflict" OnCancel="OnCancelConflict" OnReload="OnReload" OnOverwrite="OnOverwrite" />
}

@code {
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public bool IsConfirmingDiscard { get; set; }
    [Parameter] public DiskConflict? Conflict { get; set; }
    [Parameter, EditorRequired] public string FileName { get; set; } = "";
    [Parameter] public EventCallback OnSaveShortcut { get; set; }
    [Parameter] public EventCallback OnKeepEditing { get; set; }
    [Parameter] public EventCallback OnDiscard { get; set; }
    [Parameter] public EventCallback OnCancelConflict { get; set; }
    [Parameter] public EventCallback OnReload { get; set; }
    [Parameter] public EventCallback OnOverwrite { get; set; }
}
